<!doctype html>
<html lang="en">
  <%- include('../partials/head', { title }) %>
  <body>
    <%- include('../partials/header') %>
    <main class="auth-page">
      <section class="auth-panel compact-auth">
        <div>
          <p class="eyebrow">Secure login</p>
          <h1>Access your dashboard.</h1>
          <p>Customers continue to account pages, sellers go to seller tools, and admins go to the platform dashboard.</p>
        </div>
        <form class="form-card" action="/auth/login" method="post" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (errors.form) { %><div class="form-error"><%= errors.form %></div><% } %>
          <label>
            Email
            <input name="email" type="email" value="<%= values.email || '' %>" autocomplete="email" required>
            <% if (errors.email) { %><span class="field-error"><%= errors.email %></span><% } %>
          </label>
          <label>
            Password
            <input name="password" type="password" autocomplete="current-password" required>
            <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } %>
          </label>
          <button class="button button-primary" type="submit">Login</button>
          <p class="form-footnote"><a href="/auth/forgot-password">Forgot password?</a> · <a href="/auth/register">Create account</a></p>
        </form>
      </section>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
