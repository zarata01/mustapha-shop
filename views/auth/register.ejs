<!doctype html>
<html lang="en">
  <%- include('../partials/head', { title }) %>
  <body>
    <%- include('../partials/header') %>
    <main class="auth-page">
      <section class="auth-panel">
        <div>
          <p class="eyebrow">Customer account</p>
          <h1>Create your Mustapha Shop account.</h1>
          <p>Save your contact details, track orders, and speed up checkout after seller confirmation is added.</p>
        </div>
        <form class="form-card" action="/auth/register" method="post" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>
            Full name
            <input name="name" type="text" value="<%= values.name || '' %>" autocomplete="name" required>
            <% if (errors.name) { %><span class="field-error"><%= errors.name %></span><% } %>
          </label>
          <label>
            Email
            <input name="email" type="email" value="<%= values.email || '' %>" autocomplete="email" required>
            <% if (errors.email) { %><span class="field-error"><%= errors.email %></span><% } %>
          </label>
          <label>
            Phone
            <input name="phone" type="tel" value="<%= values.phone || '' %>" autocomplete="tel">
            <% if (errors.phone) { %><span class="field-error"><%= errors.phone %></span><% } %>
          </label>
          <label>
            Password
            <input name="password" type="password" autocomplete="new-password" required>
            <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } %>
          </label>
          <label>
            Confirm password
            <input name="confirmPassword" type="password" autocomplete="new-password" required>
            <% if (errors.confirmPassword) { %><span class="field-error"><%= errors.confirmPassword %></span><% } %>
          </label>
          <button class="button button-primary" type="submit">Create account</button>
          <p class="form-footnote">Already registered? <a href="/auth/login">Login instead</a>.</p>
        </form>
      </section>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
