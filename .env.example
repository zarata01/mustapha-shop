NODE_ENV=development
PORT=3000

# Prefer a normal MongoDB URI. If a mongodb+srv URI fails because DNS SRV lookups are blocked,
# set MONGODB_DIRECT_URI to the Atlas seedlist URI from the driver's "standard connection string" option.
MONGODB_URI=mongodb://127.0.0.1:27017/mustapha_shop
MONGODB_DIRECT_URI=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# In development the server can start without MongoDB so frontend work is not blocked.
# Production defaults to requiring a database even when this value is omitted.
DB_REQUIRED=false

SESSION_SECRET=replace-with-a-long-random-secret
SESSION_NAME=mustapha_shop_sid
TRUST_PROXY=false
